# Copiez ce fichier en .env pour personnaliser la configuration (facultatif).

# Clé secrète Flask. Si absente, une clé aléatoire est générée une fois
# et conservée dans instance/secret_key.
# JOBPILOT_SECRET_KEY=changez-moi-par-une-longue-chaine-aleatoire

# Adresse d'écoute : 127.0.0.1 = accessible uniquement depuis cet ordinateur.
# Ne mettez pas 0.0.0.0 tant que l'application n'a pas d'authentification.
JOBPILOT_HOST=127.0.0.1
JOBPILOT_PORT=5000

# Dossiers de données (par défaut : instance/ et uploads/ dans le projet)
# JOBPILOT_INSTANCE_DIR=D:\JobPilotData\instance
# JOBPILOT_UPLOAD_DIR=D:\JobPilotData\uploads

# Taille maximale d'un document importé (Mo) et d'une requête (Mo, restauration incluse)
JOBPILOT_MAX_UPLOAD_MB=10
JOBPILOT_MAX_REQUEST_MB=200

# Nombre de candidatures par page
JOBPILOT_ITEMS_PER_PAGE=20

# Mode débogage (1 = rechargement automatique, à n'utiliser qu'en développement)
JOBPILOT_DEBUG=0
